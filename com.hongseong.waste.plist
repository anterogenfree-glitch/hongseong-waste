<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd: 로그인 시 서버 자동 실행.  /Users/USERNAME 와 경로를 실제 값으로 바꾸세요.
     설치: cp com.hongseong.waste.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.hongseong.waste.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.hongseong.waste</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/USERNAME/hongseong-waste/server.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/USERNAME/hongseong-waste</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/USERNAME/hongseong-waste/server.log</string>
  <key>StandardErrorPath</key><string>/Users/USERNAME/hongseong-waste/server.log</string>
</dict>
</plist>
